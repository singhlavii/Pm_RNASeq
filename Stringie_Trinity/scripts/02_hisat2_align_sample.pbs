#!/bin/bash
# =============================================================================
# 02_hisat2_align_sample.pbs - align ONE sample to the hap1+hap2 assembly.
#   HISAT2 --max-intronlen 3000 --dta
#   keep mapped (-F 4) and properly paired (-f 2) alignments
#   sort and index the BAM
# =============================================================================
#PBS -P xf3
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l jobfs=100GB
#PBS -l walltime=06:00:00
#PBS -l storage=gdata/xf3+gdata/if89
#PBS -j oe
#PBS -m abe
#PBS -M u7406681@anu.edu.au

set -euo pipefail
source "$CONFIG"

R1=$TRIMMED_READS_DIR/${SAMPLE}_R1.trimmed.fastq.gz
R2=$TRIMMED_READS_DIR/${SAMPLE}_R2.trimmed.fastq.gz
BAM=$ALIGN_DIR/${SAMPLE}.mapped_paired.sorted.bam

mkdir -p "$ALIGN_DIR"
echo "Sample: $SAMPLE"

# Align -> filter -> sort in one stream (no intermediate SAM file).
# --rg-id/--rg label every read with its sample, which keeps samples
# distinguishable after replicates are merged later.
$HISAT2 -p "$PBS_NCPUS" -x "$INDEX_PREFIX" -1 "$R1" -2 "$R2" \
        --max-intronlen "$MAX_INTRON_LENGTH" --dta \
        --rg-id "$SAMPLE" --rg "SM:$SAMPLE" \
        --new-summary --summary-file "$ALIGN_DIR/${SAMPLE}.hisat2_summary.txt" \
  | $SAMTOOLS view -u -F 4 -f 2 - \
  | $SAMTOOLS sort -@ 4 -m 2G -T "$PBS_JOBFS/sort" -O bam -o "$BAM.tmp" -

mv "$BAM.tmp" "$BAM"            # only a complete BAM gets the final name
$SAMTOOLS index "$BAM"
$SAMTOOLS flagstat "$BAM" > "$ALIGN_DIR/${SAMPLE}.flagstat.txt"

cat "$ALIGN_DIR/${SAMPLE}.hisat2_summary.txt"
echo "Done: $BAM"
