#!/bin/bash
# =============================================================================
# 07_bam_to_reads_by_haplotype.pbs - turn ONE step-5 BAM (time point x haplotype,
# replicates already merged) back into paired FASTQ reads.
# Primary alignments only (samtools fastq default), as in Rita's bam2fq step.
# =============================================================================
#PBS -P xf3
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=16GB
#PBS -l jobfs=200GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/xf3+gdata/if89

set -euo pipefail
source "$CONFIG"

TP_NAME=${TIMEPOINT}${TIMEPOINT_UNIT}
IN_BAM=$HAPLOTYPE_DIR/${TP_NAME}.${HAP}.bam
OUT=$READS_BY_HAP_DIR/${TP_NAME}.${HAP}
mkdir -p "$READS_BY_HAP_DIR"

# collate puts mates next to each other; fastq writes them to R1 / R2
$SAMTOOLS collate -@ "$PBS_NCPUS" -u -O -T "$PBS_JOBFS/collate" "$IN_BAM" \
  | $SAMTOOLS fastq -@ "$PBS_NCPUS" -n \
        -1 "$OUT.tmp_R1.fastq.gz" -2 "$OUT.tmp_R2.fastq.gz" \
        -0 /dev/null -s /dev/null -
mv "$OUT.tmp_R1.fastq.gz" "${OUT}_R1.fastq.gz"
mv "$OUT.tmp_R2.fastq.gz" "${OUT}_R2.fastq.gz"

echo "read pairs: $(( $(zcat "${OUT}_R1.fastq.gz" | wc -l) / 4 ))"
echo "Done: ${OUT}_R1.fastq.gz / _R2.fastq.gz"
