#!/bin/bash
# =============================================================================
# 01_hisat2_build_index.pbs - build the HISAT2 index of the hap1+hap2 assembly.
# =============================================================================
#PBS -P xf3
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/xf3+gdata/if89
#PBS -j oe
#PBS -m abe
#PBS -M u7406681@anu.edu.au

set -euo pipefail
source "$CONFIG"

mkdir -p "$INDEX_DIR"
echo "Assembly: $ASSEMBLY_HAP1_HAP2"
echo "Sequences: $(grep -c '>' "$ASSEMBLY_HAP1_HAP2")"

# hisat2-build is a Python script; Gadi requires Python 3 to be named explicitly
python3 "$HISAT2_BUILD" -p "$PBS_NCPUS" "$ASSEMBLY_HAP1_HAP2" "$INDEX_PREFIX"

ls -lh "$INDEX_DIR"
echo "Done"
