#!/bin/bash
# =============================================================================
# 04_merge_replicates_by_timepoint.pbs - merge the replicate BAMs of ONE time
# point into a single BAM (more reads per condition = more complete transcripts).
# Samples are named <timepoint>-<replicate>, e.g. 3-1 3-3 3-4 3-5 -> 3dpi.
# =============================================================================
#PBS -P xf3
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=16GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/xf3+gdata/if89

set -euo pipefail
source "$CONFIG"

mkdir -p "$MERGED_DIR"
TP_NAME=${TIMEPOINT}${TIMEPOINT_UNIT}                 # e.g. 3dpi
MERGED_BAM=$MERGED_DIR/${TP_NAME}.merged.bam

# Replicate BAMs for this time point ("${TIMEPOINT}-" so that 1- never matches 12-)
REPLICATES=$(ls "$ALIGN_DIR"/${TIMEPOINT}-*.mapped_paired.sorted.bam | sort -V)
echo "$TP_NAME - merging $(echo "$REPLICATES" | wc -l) replicates:"
echo "$REPLICATES"

# Inputs are already coordinate-sorted, so the merged BAM is too.
# Each read keeps its sample label (read group) from step 2.
$SAMTOOLS merge -@ "$PBS_NCPUS" -o "$MERGED_BAM.tmp" -O bam $REPLICATES
mv "$MERGED_BAM.tmp" "$MERGED_BAM"
$SAMTOOLS index "$MERGED_BAM"

ls -lh "$MERGED_BAM"
echo "Done"
